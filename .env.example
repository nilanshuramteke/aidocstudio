# Copy to .env and fill in. Never commit .env.

# Required. A long random secret; it is the "password" for signing in. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADSTUDIO_ACCESS_TOKEN=

# Where Ollama runs. Default: Ollama on the Docker host. With `--profile ollama`: http://ollama:11434
# ADSTUDIO_OLLAMA_URL=http://host.docker.internal:11434

# Only if you open the app by a name or IP other than localhost (LAN, reverse proxy). Comma separated, no ports.
# ADSTUDIO_ALLOWED_HOSTS=nas.local,192.168.1.20
